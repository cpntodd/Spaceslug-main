#version 450
// Masked correctness-first RMSNorm backward. Mask is per row: zero excludes row.
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer X{float x[];};
layout(std430,binding=1) readonly buffer Gamma{float gamma[];};
layout(std430,binding=2) readonly buffer DY{float dy[];};
layout(std430,binding=3) readonly buffer Mask{uint mask[];};
layout(std430,binding=4) writeonly buffer DX{float dx[];};
layout(push_constant) uniform PC{uint rows;uint hidden;}pc;
void main(){uint r=gl_WorkGroupID.x,t=gl_LocalInvocationID.x;if(r>=pc.rows)return;uint b=r*pc.hidden;if(mask[r]==0u){for(uint i=t;i<pc.hidden;i+=256)dx[b+i]=0.;return;}float ss=0.,dot=0.;for(uint j=0;j<pc.hidden;++j){float xv=x[b+j];ss+=xv*xv;dot+=xv*dy[b+j]*gamma[j];}float inv=inversesqrt(ss/float(pc.hidden)+1e-5);for(uint i=t;i<pc.hidden;i+=256)dx[b+i]=gamma[i]*inv*dy[b+i]-x[b+i]*dot*inv*inv*inv/float(pc.hidden);}
