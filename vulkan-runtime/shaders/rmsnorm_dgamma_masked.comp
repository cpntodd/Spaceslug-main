#version 450
// Masked deterministic RMSNorm gamma gradient; zero mask excludes a row.
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer X{float x[];};
layout(std430,binding=1) readonly buffer DY{float dy[];};
layout(std430,binding=2) readonly buffer Mask{uint mask[];};
layout(std430,binding=3) writeonly buffer DG{float dgamma[];};
layout(push_constant) uniform PC{uint rows;uint hidden;}pc;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=pc.hidden)return;float sum=0.;for(uint r=0u;r<pc.rows;++r){if(mask[r]==0u)continue;uint b=r*pc.hidden;float ss=0.;for(uint j=0u;j<pc.hidden;++j)ss+=x[b+j]*x[b+j];float inv=inversesqrt(ss/float(pc.hidden)+1e-5);sum+=x[b+i]*inv*dy[b+i];}dgamma[i]=sum;}
