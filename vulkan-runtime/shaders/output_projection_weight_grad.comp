#version 450
// Deterministic dW[h,o] = sum_t activation[t,h] * upstream[t,o].
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer A { float a[]; };
layout(std430,binding=1) readonly buffer U { float u[]; };
layout(std430,binding=2) writeonly buffer G { float g[]; };
layout(push_constant) uniform PC { uint rows; uint tcap; uint hidden; } pc;
void main(){ uint id=gl_GlobalInvocationID.x, n=pc.hidden*pc.hidden; if(id>=n)return; uint h=id/pc.hidden, o=id%pc.hidden; float s=0.; for(uint t=0u;t<pc.tcap;++t) if(t<pc.rows) s+=a[t*pc.hidden+h]*u[t*pc.hidden+o]; g[id]=s; }

