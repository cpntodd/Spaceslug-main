#version 450
// True masked RMSNorm dgamma using forward-preserved raw x and inv_rms.
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer X{float x[];};
layout(std430,binding=1) readonly buffer DY{float dy[];};
layout(std430,binding=2) readonly buffer Mask{uint mask[];};
layout(std430,binding=3) readonly buffer InvRms{float inv_rms[];};
layout(std430,binding=4) writeonly buffer DG{float dgamma[];};
layout(push_constant) uniform PC{uint rows;uint hidden;}pc;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=pc.hidden)return;float sum=0.;for(uint r=0u;r<pc.rows;++r)if(mask[r]!=0u){uint b=r*pc.hidden;sum+=x[b+i]*inv_rms[r]*dy[b+i];}dgamma[i]=sum;}
