#version 450
// FFN parameter-gradient seam for true RMSNorm state: the FFN receives the
// normalized state produced upstream. Kept separate until full graph wiring.
layout(local_size_x=256) in;
layout(std430,binding=0) readonly buffer X{float x[];};
layout(std430,binding=1) readonly buffer W1{float w1[];};
layout(std430,binding=2) readonly buffer B1{float b1[];};
layout(std430,binding=3) readonly buffer W2{float w2[];};
layout(std430,binding=4) readonly buffer DY{float dy[];};
layout(std430,binding=5) writeonly buffer DW1{float dw1[];};
layout(std430,binding=6) writeonly buffer DB1{float db1[];};
layout(std430,binding=7) writeonly buffer DW2{float dw2[];};
layout(std430,binding=8) writeonly buffer DB2{float db2[];};
layout(std430,binding=9) readonly buffer Mask{uint mask[];};
layout(push_constant)uniform PC{uint rows;uint hidden;uint intermediate;}pc;
const float A=.7978845608028654;float gelu(float z){return .5*z*(1.+tanh(A*(z+.044715*z*z*z)));}float gd(float z){float t=tanh(A*(z+.044715*z*z*z));return .5*(1.+t)+.5*z*(1.-t*t)*A*(1.+3.*.044715*z*z);}
void main(){uint id=gl_GlobalInvocationID.x,p1=pc.hidden*pc.intermediate,p2=pc.intermediate*pc.hidden,total=p1+pc.intermediate+p2+pc.hidden;if(id>=total)return;if(id<p1){uint i=id/pc.intermediate,j=id%pc.intermediate;float s=0.;for(uint r=0;r<pc.rows;++r)if(mask[r]!=0u){uint b=r*pc.hidden;float z=b1[j];for(uint k=0;k<pc.hidden;++k)z+=x[b+k]*w1[k*pc.intermediate+j];float u=0.;for(uint o=0;o<pc.hidden;++o)u+=dy[b+o]*w2[j*pc.hidden+o];s+=x[b+i]*gd(z)*u;}dw1[id]=s;}else if(id<p1+pc.intermediate){uint j=id-p1;float s=0.;for(uint r=0;r<pc.rows;++r)if(mask[r]!=0u){uint b=r*pc.hidden;float z=b1[j];for(uint k=0;k<pc.hidden;++k)z+=x[b+k]*w1[k*pc.intermediate+j];float u=0.;for(uint o=0;o<pc.hidden;++o)u+=dy[b+o]*w2[j*pc.hidden+o];s+=gd(z)*u;}db1[j]=s;}else if(id<p1+pc.intermediate+p2){uint j=(id-p1-pc.intermediate)/pc.hidden,o=(id-p1-pc.intermediate)%pc.hidden;float s=0.;for(uint r=0;r<pc.rows;++r)if(mask[r]!=0u){uint b=r*pc.hidden;float z=b1[j];for(uint k=0;k<pc.hidden;++k)z+=x[b+k]*w1[k*pc.intermediate+j];s+=gelu(z)*dy[b+o];}dw2[j*pc.hidden+o]=s;}else{uint o=id-p1-pc.intermediate-p2;float s=0.;for(uint r=0;r<pc.rows;++r)if(mask[r]!=0u)s+=dy[r*pc.hidden+o];db2[o]=s;}}
