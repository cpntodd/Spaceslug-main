#version 450

// cast: fp16 <-> fp32 elementwise, direction selected by push constant.
//
//   direction == 0: fp16 -> fp32  (in_data holds PACKED fp16, out_data holds fp32 bits)
//   direction == 1: fp32 -> fp16  (in_data holds fp32 bits, out_data holds PACKED fp16)
//
// M7a: the fp16 side is now PACKED — 2 values per uint32 (even index = low
// half, odd index = high half, byte-identical to fp16pack mode 1). The fp32
// side is unchanged (uint32 via uintBitsToFloat/floatBitsToUint, exact
// bit-copy). `count` is still the number of ELEMENTS; one thread per packed
// input word (direction 0) or packed output word (direction 1).
//
// The pack/unpack conversions are IEEE 754 binary16 round-to-nearest-even
// round-trips (unpackHalf2x16 is exact; packHalf2x16 rounds-toward-zero on
// RADV, within 1 fp16 ULP of clang's static_cast<__fp16>). The test compares
// f16->f32 bit-exactly and f32->f16 to within 1 ULP.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer InBuf  { uint in_data[];  };
layout(std430, binding = 1) writeonly buffer OutBuf { uint out_data[]; };

layout(push_constant) uniform PC {
    uint direction; // 0 = f16->f32, 1 = f32->f16
    uint count;     // number of ELEMENTS
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x; // word index (packed fp16 side)
    uint nwords = (pc.count + 1u) / 2u;
    if (i >= nwords) return;

    uint e0 = i * 2u;
    uint e1 = e0 + 1u;

    if (pc.direction == 0u) {
        // packed fp16 -> fp32 bits
        vec2 h = unpackHalf2x16(in_data[i]);
        out_data[e0] = floatBitsToUint(h.x);
        if (e1 < pc.count) out_data[e1] = floatBitsToUint(h.y);
    } else {
        // fp32 bits -> packed fp16
        float f0 = uintBitsToFloat(in_data[e0]);
        float f1 = (e1 < pc.count) ? uintBitsToFloat(in_data[e1]) : 0.0;
        out_data[i] = packHalf2x16(vec2(f0, f1));
    }
}
