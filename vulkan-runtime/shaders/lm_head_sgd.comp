#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer WeightBuffer { float weight[]; };
layout(std430, binding = 1) readonly buffer GradientBuffer { float gradient[]; };
layout(push_constant) uniform PC { uint count; float learning_rate; } pc;
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.count) return;
    weight[id] -= pc.learning_rate * gradient[id];
}
