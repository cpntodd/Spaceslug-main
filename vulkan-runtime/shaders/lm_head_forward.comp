#version 450
// Bounded post-FFN LM-head projection: logits[row,token] = projected[row,:] * W[:,token].
layout(local_size_x = 256) in;
layout(std430,binding=0) readonly buffer Projected { float projected[]; };
layout(std430,binding=1) readonly buffer LmHead { float lm_head[]; };
layout(std430,binding=2) writeonly buffer Logits { float logits[]; };
layout(push_constant) uniform PC { uint rows; uint hidden; uint vocab; uint stride; } pc;
void main() {
    uint id = gl_GlobalInvocationID.x;
    uint total = pc.rows * pc.vocab;
    if (id >= total) return;
    uint row = id / pc.vocab;
    uint token = id % pc.vocab;
    float value = 0.0;
    for (uint c = 0u; c < pc.hidden; ++c)
        value += projected[row * pc.hidden + c] * lm_head[c * pc.stride + token];
    logits[row * pc.stride + token] = value;
}
