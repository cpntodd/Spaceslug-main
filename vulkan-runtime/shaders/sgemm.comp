#version 450

// sgemm: C[M x N] = A[M x K] * B[K x N], fp32, all row-major.
//
// 64x64 output tile per workgroup, 256 threads (16x16 grid = 4 wave64 on
// gfx803/Polaris). Each thread owns a 4x4 micro-tile (16 accumulators).
//
// K-loop streams through K in BK=32 chunks; the A tile (64x32) and B tile
// (32x64) are staged into LDS each chunk. Single-buffered: a barrier separates
// the load phase from the compute phase, and a second barrier prevents the
// next chunk's loads from overwriting LDS still being read.
//
// gfx803 (Polaris) rules:
//   - wave64 only: 256 threads = 4 waves (multiple of 64).
//   - LDS <= 32 KB/workgroup. Here: A 64*34 + B 32*66 = 8704 + 8448 = 17152 B.
//   - LDS row stride == 2 (mod 32) floats (34 and 66) to avoid bank conflicts
//     (a 64-wide row at stride 64 would map 2 lanes onto the same bank).
//   - fp32 FMA only (no packed fp16, no coop matrices on this GPU). The inner
//     loop is written as `acc += bk * a` (mul+add): glslc -O emits OpFMul +
//     OpFAdd, and RADV's ACO backend fuses those into V_FMA (the GCN fused
//     multiply-add) at codegen time.
//
// Host contract (asserted on the host, not re-checked here so the body stays
// branch-free): M % 64 == 0, N % 64 == 0, K % 32 == 0.

#define BM 64   // tile rows (M dimension)
#define BN 64   // tile cols (N dimension)
#define BK 32   // K chunk
#define APAD 34 // A LDS row stride: BM-tile width BK + 2 (== 2 mod 32)
#define BPAD 66 // B LDS row stride: BK rows x (BN+2) cols (== 2 mod 32)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer A { float a[]; };
layout(std430, binding = 1) readonly  buffer B { float b[]; };
layout(std430, binding = 2) writeonly buffer C { float c[]; };

layout(push_constant) uniform PC {
    uint M; // rows of C / A
    uint N; // cols of C / B
    uint K; // inner dim
} pc;

shared float sa[BM * APAD]; // 64 * 34 = 2176 floats (8704 B)
shared float sb[BK * BPAD]; // 32 * 66 = 2112 floats (8448 B)

void main() {
    uint tx = gl_LocalInvocationID.x; // 0..15 -> tile column group
    uint ty = gl_LocalInvocationID.y; // 0..15 -> tile row group
    uint tid = ty * 16u + tx;         // 0..255

    uint tile_m = gl_WorkGroupID.y;
    uint tile_n = gl_WorkGroupID.x;

    uint gm = tile_m * BM; // global M offset of this tile
    uint gn = tile_n * BN; // global N offset of this tile

    uint r0 = ty * 4u; // local row of this thread's micro-tile
    uint c0 = tx * 4u; // local col of this thread's micro-tile

    // 16 accumulators (4 rows x 4 cols), resident in VGPRs.
    vec4 acc[4];
    acc[0] = vec4(0.0);
    acc[1] = vec4(0.0);
    acc[2] = vec4(0.0);
    acc[3] = vec4(0.0);

    for (uint k0 = 0u; k0 < pc.K; k0 += BK) {
        // ---- stage A tile (BM x BK) from global A (M x K row-major) ----
        // 64*32 = 2048 elements; 256 threads -> 8 each.
        for (uint r = 0u; r < 8u; ++r) {
            uint idx = tid + r * 256u;
            uint row = idx / BK; // 0..63
            uint col = idx % BK; // 0..31
            sa[row * APAD + col] = a[(gm + row) * pc.K + (k0 + col)];
        }

        // ---- stage B tile (BK x BN) from global B (K x N row-major) ----
        // 32*64 = 2048 elements; 256 threads -> 8 each.
        for (uint r = 0u; r < 8u; ++r) {
            uint idx = tid + r * 256u;
            uint row = idx / BN; // 0..31
            uint col = idx % BN; // 0..63
            sb[row * BPAD + col] = b[(k0 + row) * pc.N + (gn + col)];
        }

        barrier(); // LDS writes visible to all threads before compute

        // ---- compute: 4x4 micro-tile, vec2 A loads + vec4 B loads + FMA ----
        for (uint k = 0u; k < BK; k += 2u) {
            vec2 a0 = vec2(sa[(r0 + 0u) * APAD + k], sa[(r0 + 0u) * APAD + k + 1u]);
            vec2 a1 = vec2(sa[(r0 + 1u) * APAD + k], sa[(r0 + 1u) * APAD + k + 1u]);
            vec2 a2 = vec2(sa[(r0 + 2u) * APAD + k], sa[(r0 + 2u) * APAD + k + 1u]);
            vec2 a3 = vec2(sa[(r0 + 3u) * APAD + k], sa[(r0 + 3u) * APAD + k + 1u]);

            vec4 bk = vec4(sb[(k + 0u) * BPAD + c0 + 0u],
                           sb[(k + 0u) * BPAD + c0 + 1u],
                           sb[(k + 0u) * BPAD + c0 + 2u],
                           sb[(k + 0u) * BPAD + c0 + 3u]);
            vec4 bk1 = vec4(sb[(k + 1u) * BPAD + c0 + 0u],
                            sb[(k + 1u) * BPAD + c0 + 1u],
                            sb[(k + 1u) * BPAD + c0 + 2u],
                            sb[(k + 1u) * BPAD + c0 + 3u]);

            acc[0] += bk * a0.xxxx;
            acc[0] += bk1 * a0.yyyy;
            acc[1] += bk * a1.xxxx;
            acc[1] += bk1 * a1.yyyy;
            acc[2] += bk * a2.xxxx;
            acc[2] += bk1 * a2.yyyy;
            acc[3] += bk * a3.xxxx;
            acc[3] += bk1 * a3.yyyy;
        }

        barrier(); // all threads done reading LDS before next chunk overwrites
    }

    // ---- store C micro-tile (4x4) ----
    uint crow0 = gm + r0;
    uint ccol0 = gn + c0;
    c[(crow0 + 0u) * pc.N + ccol0] = acc[0].x;
    c[(crow0 + 0u) * pc.N + ccol0 + 1u] = acc[0].y;
    c[(crow0 + 0u) * pc.N + ccol0 + 2u] = acc[0].z;
    c[(crow0 + 0u) * pc.N + ccol0 + 3u] = acc[0].w;
    c[(crow0 + 1u) * pc.N + ccol0] = acc[1].x;
    c[(crow0 + 1u) * pc.N + ccol0 + 1u] = acc[1].y;
    c[(crow0 + 1u) * pc.N + ccol0 + 2u] = acc[1].z;
    c[(crow0 + 1u) * pc.N + ccol0 + 3u] = acc[1].w;
    c[(crow0 + 2u) * pc.N + ccol0] = acc[2].x;
    c[(crow0 + 2u) * pc.N + ccol0 + 1u] = acc[2].y;
    c[(crow0 + 2u) * pc.N + ccol0 + 2u] = acc[2].z;
    c[(crow0 + 2u) * pc.N + ccol0 + 3u] = acc[2].w;
    c[(crow0 + 3u) * pc.N + ccol0] = acc[3].x;
    c[(crow0 + 3u) * pc.N + ccol0 + 1u] = acc[3].y;
    c[(crow0 + 3u) * pc.N + ccol0 + 2u] = acc[3].z;
    c[(crow0 + 3u) * pc.N + ccol0 + 3u] = acc[3].w;
}
