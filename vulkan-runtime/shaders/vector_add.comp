#version 450

// vector_add: elementwise c[i] = a[i] + b[i] over N fp32 elements.
//
// gfx803 (Polaris) rules:
//   - Wave64: workgroup size 256 = 4 waves (multiple of 64).
//   - No LDS needed for this kernel.
//   - fp32 math only (Polaris has no 2x packed fp16).
//
// N must be an exact multiple of 256: the host dispatches N/256 workgroups and
// no bounds check is emitted, so the body is a single FADD with no divergence.

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly  buffer InA { float data[]; } in_a;
layout(std430, binding = 1) readonly  buffer InB { float data[]; } in_b;
layout(std430, binding = 2) writeonly buffer Out { float data[]; } out_buf;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    out_buf.data[gid] = in_a.data[gid] + in_b.data[gid];
}
