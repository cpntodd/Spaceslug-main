#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) buffer DA { float da[]; };
layout(std430, binding = 1) buffer DB { float db[]; };
layout(push_constant) uniform PC { uint elements; } pc;
void main() { uint id = gl_GlobalInvocationID.x; if (id < pc.elements) { da[id] = 0.0; db[id] = 0.0; } }
