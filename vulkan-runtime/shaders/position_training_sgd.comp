#version 450
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Position { float position[]; };
layout(std430, binding = 1) readonly buffer Gradient { float gradient[]; };
layout(push_constant) uniform PC { uint hidden; uint rows; float learning_rate; } pc;
void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id < pc.rows * pc.hidden)
        position[id] -= pc.learning_rate * gradient[id];
}
