#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer Tokens { uint tokens[]; };
layout(std430, binding = 1) readonly buffer Targets { uint targets[]; };
layout(std430, binding = 2) readonly buffer Mask { uint mask[]; };
layout(std430, binding = 3) readonly buffer DOutput { float doutput[]; };
layout(std430, binding = 4) readonly buffer Learning { float learning[]; };
layout(std430, binding = 5) buffer Output { float results[]; };
layout(std430, binding = 6) buffer Control { uint control[]; };
// Fixed-shape diagnostic chain: forward -> masked loss/dlogit -> backward -> LoRA update.
// It deliberately uses tiny scalar state so command reuse can be tested independently
// of the production Tiny graph's mutable push constants.
void main() {
    if (gl_GlobalInvocationID.x != 0u) return;
    float loss = 0.0;
    float grad = 0.0;
    float update = learning[0];
    for (uint i = 0u; i < 8u; ++i) {
        float forward = float(tokens[i]) * 0.01 + float(control[i]) * 0.001;
        float error = forward - float(targets[i]);
        loss += float(mask[i]) * error * error;
        grad += float(mask[i]) * error * doutput[i];
        update -= learning[1] * grad;
    }
    results[0] = loss;
    results[1] = grad;
    results[2] = update;
    results[3] = float(control[8]);
}
void main_unused() {}
