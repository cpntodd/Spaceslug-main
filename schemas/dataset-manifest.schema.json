{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceslug.local/schemas/dataset-manifest.schema.json",
  "title": "Spaceslug Dataset Bundle manifest",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "dataset_id",
    "revision",
    "record_count",
    "splits",
    "encoding",
    "tokenizer",
    "preprocessing",
    "provenance",
    "files"
  ],
  "properties": {
    "format": {"const": "spaceslug-dataset"},
    "schema_version": {"type": "integer", "minimum": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "parent_revision": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "record_count": {"type": "integer", "minimum": 0},
    "token_count": {"type": "integer", "minimum": 0},
    "splits": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "test": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "encoding": {
      "type": "object",
      "required": ["text", "compression"],
      "properties": {
        "text": {"const": "utf-8"},
        "compression": {"enum": ["none", "zstd"]},
        "token_ids": {"enum": ["uint16", "uint32"]}
      },
      "additionalProperties": false
    },
    "tokenizer": {
      "type": "object",
      "required": ["id", "revision", "vocab_size"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "vocab_size": {"type": "integer", "minimum": 1},
        "chat_template_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "preprocessing": {
      "type": "object",
      "required": ["pipeline", "revision", "seed"],
      "properties": {
        "pipeline": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "config": {"type": "object"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["sources", "licenses"],
      "properties": {
        "sources": {"type": "array", "items": {"type": "string"}},
        "licenses": {"type": "array", "items": {"type": "string"}},
        "privacy_status": {"enum": ["unknown", "reviewed", "redacted"]}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "records": {"type": "integer", "minimum": 0},
          "split": {"enum": ["train", "validation", "test", "metadata", "derived"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
